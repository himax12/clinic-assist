# Copy to .env, then enter your API key locally. Never commit .env.
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_REQUEST_INTERVAL=12
MODEL_REQUEST_TIMEOUT=60
# Optional alternate provider; only selected with LLM_PROVIDER=openai or --provider openai.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
# Optional current model pricing for approximate run cost; USD per 1M tokens.
INPUT_USD_PER_MILLION=
OUTPUT_USD_PER_MILLION=
